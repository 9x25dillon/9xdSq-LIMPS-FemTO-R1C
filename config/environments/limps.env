# Unified LIMPS Environment Configuration
export LIMPS_HOME="$(pwd)"
export LIMPS_JULIA_PATH="$LIMPS_HOME/limps_core/julia"
export LIMPS_PYTHON_PATH="$LIMPS_HOME/limps_core/python"

# Julia environment
export JULIA_PROJECT="$LIMPS_JULIA_PATH"
export JULIA_LOAD_PATH="$LIMPS_JULIA_PATH:$JULIA_LOAD_PATH"

# Python environment  
export PYTHONPATH="$LIMPS_HOME:$PYTHONPATH"

# GPU settings
export CUDA_VISIBLE_DEVICES="0"
export USE_GPU="1"

# API settings
export LIMPS_API_PORT="8000"
export LIMPS_API_HOST="localhost"

# Database settings
export POSTGRES_DSN="postgresql://user:pass@localhost/limps_db"
export REDIS_URL="redis://localhost:6379/0"

# Monitoring
export PROMETHEUS_PORT="9090"
export GRAFANA_PORT="3000"
